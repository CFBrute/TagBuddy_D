<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway spike: learn the Proxmark3 wire protocol fast on Windows (the device is a COM port here), then
       port the proven framing/commands into TagBuddy/Services/ProxmarkUsb.cs. Not part of the app build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
  </ItemGroup>

  <!-- Reuse the app's Crypto1 solver here so the nested attack is proven on hardware before trusting it in the app. -->
  <ItemGroup>
    <Compile Include="..\TagBuddy\Services\Crypto1.cs" />
  </ItemGroup>

</Project>
